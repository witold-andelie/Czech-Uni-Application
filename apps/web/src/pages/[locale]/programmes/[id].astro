---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import InstitutionTags from "../../../components/InstitutionTags.astro";
import SaveButton from "../../../components/SaveButton.svelte";
import CompareButton from "../../../components/CompareButton.svelte";
import { findOffering, primaryApplicationUrl } from "../../../lib/catalog";
import { formatTuition, hostOf, roundLabel, teachingLanguageLabel, text, windowRange, windowStatusLabel } from "../../../lib/format";
import { LOCALES, localeFromParam, t } from "../../../lib/i18n";
import { loadCatalog } from "../../../lib/loadCatalog";

export function getStaticPaths() {
  const catalog = loadCatalog();
  return LOCALES.flatMap((locale) =>
    catalog.offerings.map((offering) => ({ params: { locale, id: offering.id } })),
  );
}

const locale = localeFromParam(Astro.params.locale);
const catalog = loadCatalog();
const view = findOffering(catalog, Astro.params.id ?? "", new Date());
if (!view) throw new Error("Missing offering");
const applyUrl = primaryApplicationUrl(view.summary, view.offering.applicationUrl);
const current = view.summary.current[0];
---
<BaseLayout locale={locale} title={text(view.offering.title, locale)}>
  <main id="main" class="page detail-grid">
    <p><a href={`/${locale}/programmes`}>{t(locale, "action.back")}</a></p>
    <p class="muted">{t(locale, "fixture.card")} · {view.offering.academicYear}</p>
    <h1>{text(view.offering.title, locale)}</h1>
    <p>
      <a href={`/${locale}/institutions/${view.institution.id}`}>{text(view.institution.displayName, locale)}</a>
      · {text(view.institution.city, locale)}
    </p>
    <InstitutionTags locale={locale} institution={view.institution} />

    <section class="summary-grid" aria-labelledby="summary">
      <h2 id="summary" class="visually-hidden">{t(locale, "detail.summary")}</h2>
      <div class="panel">
        <p class="muted">{t(locale, "detail.teachingLanguage")}</p>
        <p>{teachingLanguageLabel(view.offering.teachingLanguages, view.offering.languageMode, locale)}</p>
      </div>
      <div class="panel">
        <p class="muted">{t(locale, "detail.degree")}</p>
        <p>{t(locale, `degree.${view.offering.degree}`)}</p>
      </div>
      <div class="panel">
        <p class="muted">{t(locale, "detail.tuition")}</p>
        <p>{formatTuition(view.offering.tuition, locale)}</p>
      </div>
      <div class="panel">
        <p class="muted">{t(locale, "application.currentRound")}</p>
        <p>{windowStatusLabel(view.summary.opportunityStatus, locale)}</p>
        {current && <p>{roundLabel(current, locale)} · {windowRange(current, locale)}</p>}
      </div>
    </section>

    {view.offering.additionalLanguageRequirements.map((item) => (
      <p class="notice">
        {t(locale, "teaching.additional")} · {item.language} / {item.context} / {item.requirement}
        {item.note ? ` — ${text(item.note, locale)}` : ""}
      </p>
    ))}

    <section class="panel">
      <h2>{t(locale, "application.timeline")}</h2>
      {view.windows.length === 0 && <p>{t(locale, "application.roundUnknown")}</p>}
      {view.windows.map((window) => (
        <article>
          <h3>{roundLabel(window, locale)} {window.roundLabelOriginal ? `· ${window.roundLabelOriginal}` : ""}</h3>
          <p>{windowRange(window, locale)}</p>
          {window.applicantScope && <p>{t(locale, "application.scope")}：{text(window.applicantScope, locale)}</p>}
          {window.conditionalOnVacancies && <p class="notice">{t(locale, "application.vacanciesConditional")}</p>}
          {window.applicationUrl && view.summary.opportunityStatus !== "closed" && (
            <p>
              <a href={window.applicationUrl} rel="noopener noreferrer" target="_blank">
                {t(locale, "action.official")} ({hostOf(window.applicationUrl)})
              </a>
            </p>
          )}
        </article>
      ))}
    </section>

    <div class="actions">
      {applyUrl && view.summary.opportunityStatus === "open" && (
        <a class="btn primary" href={applyUrl} rel="noopener noreferrer" target="_blank">
          {t(locale, "action.official")} · {hostOf(applyUrl)}
        </a>
      )}
      <SaveButton client:load locale={locale} id={`offering:${view.offering.id}`} />
      <CompareButton client:load locale={locale} id={`offering:${view.offering.id}`} />
    </div>
    <p class="disclaimer">{t(locale, "detail.notSubmitted")}</p>
    <p class="muted">{t(locale, "source.label")} · {t(locale, "source.verified")}：{t(locale, "status.unknown")}</p>
  </main>
</BaseLayout>
<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
