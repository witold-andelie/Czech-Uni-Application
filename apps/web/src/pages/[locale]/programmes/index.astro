---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProgrammeResults from "../../../components/ProgrammeResults.svelte";
import { LOCALES, localeFromParam, t } from "../../../lib/i18n";
import { loadCatalog } from "../../../lib/loadCatalog";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeFromParam(Astro.params.locale);
const catalog = loadCatalog();
---
<BaseLayout locale={locale} title={t(locale, "nav.programmes")}>
  <main id="main" class="page">
    <h1>{t(locale, "nav.programmes")}</h1>
    <p class="lede">{t(locale, "teaching.prompt")}</p>
    <div class="chooser two">
      <a class="choice-card" href={`/${locale}/programmes?teachingLanguage=en`}>
        <h2>{t(locale, "teaching.en")}</h2>
        <p>{t(locale, "teaching.en.help")}</p>
      </a>
      <a class="choice-card" href={`/${locale}/programmes?teachingLanguage=cs`}>
        <h2>{t(locale, "teaching.cs")}</h2>
        <p>{t(locale, "teaching.cs.help")}</p>
      </a>
    </div>
    <p><a class="secondary-link" href={`/${locale}/programmes?teachingLanguage=all`}>{t(locale, "teaching.all")}</a></p>
    <ProgrammeResults client:load catalog={catalog} locale={locale} />
  </main>
</BaseLayout>
