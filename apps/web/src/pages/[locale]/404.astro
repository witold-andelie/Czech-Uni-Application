---
import { withBase } from "../../lib/base.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LOCALES, localeFromParam, t } from "../../lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeFromParam(Astro.params.locale);
---
<BaseLayout locale={locale} title={t(locale, "error.notFound")}>
  <main id="main" class="page">
    <section class="empty card">
      <h1>{t(locale, "error.notFound")}</h1>
      <p>{t(locale, "error.notFound.help")}</p>
      <div class="actions">
        <a class="btn primary" href={withBase(`/${locale}/`)}>{t(locale, "error.home")}</a>
        <a class="btn" href={withBase(`/${locale}/programmes`)}>{t(locale, "nav.programmes")}</a>
      </div>
      <p>
        <a href="/zh-CN/" lang="zh-CN" hreflang="zh-CN">简体中文</a>
        {" · "}
        <a href="/en/" lang="en" hreflang="en">English</a>
        {" · "}
        <a href="/cs/" lang="cs" hreflang="cs">Čeština</a>
      </p>
    </section>
  </main>
</BaseLayout>
