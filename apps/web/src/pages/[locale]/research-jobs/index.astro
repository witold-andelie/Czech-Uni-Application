---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import JobResults from "../../../components/JobResults.svelte";
import { LOCALES, localeFromParam, t } from "../../../lib/i18n";
import { loadCatalog } from "../../../lib/loadCatalog";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeFromParam(Astro.params.locale);
const catalog = loadCatalog();
---
<BaseLayout locale={locale} title={t(locale, "nav.research")}>
  <main id="main" class="page">
    <h1>{t(locale, "nav.research")}</h1>
    <p class="lede">{t(locale, "jobs.prompt")}</p>
    <JobResults client:load catalog={catalog} locale={locale} />
  </main>
</BaseLayout>
