---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import InstitutionTags from "../../../components/InstitutionTags.astro";
import SaveButton from "../../../components/SaveButton.svelte";
import { findJob, primaryApplicationUrl } from "../../../lib/catalog";
import { hostOf, roundLabel, text, windowRange, windowStatusLabel } from "../../../lib/format";
import { LOCALES, localeFromParam, t } from "../../../lib/i18n";
import { loadCatalog } from "../../../lib/loadCatalog";

export function getStaticPaths() {
  const catalog = loadCatalog();
  return LOCALES.flatMap((locale) => catalog.jobs.map((job) => ({ params: { locale, id: job.id } })));
}

const locale = localeFromParam(Astro.params.locale);
const catalog = loadCatalog();
const view = findJob(catalog, Astro.params.id ?? "", new Date());
if (!view) throw new Error("Missing job");
const applyUrl = primaryApplicationUrl(view.summary, view.job.applicationUrl);
const applyLabel = view.job.applicationMethod === "official_instructions" ? t(locale, "action.officialInstructions") : t(locale, "action.applyNow");
const closed = view.summary.opportunityStatus === "closed" || view.job.wholeOpportunityClosed;
const phdKey =
  view.job.doctoralEnrollment === "not_required"
    ? "jobs.phd.no"
    : view.job.doctoralEnrollment === "unspecified"
      ? "jobs.phd.unknown"
      : `jobs.phd.${view.job.doctoralEnrollment}`;
---
<BaseLayout locale={locale} title={text(view.job.title, locale)}>
  <main id="main" class="page detail-grid">
    <p><a href={`/${locale}/research-jobs`}>{t(locale, "action.back")}</a></p>
    <p class="muted">{t(locale, "fixture.card")}</p>
    <h1>
      {closed || !applyUrl ? (
        text(view.job.title, locale)
      ) : (
        <a href={applyUrl} rel="noopener noreferrer" target="_blank">{text(view.job.title, locale)}</a>
      )}
    </h1>
    <p>{text(view.employer.displayName, locale)} · {text(view.job.city, locale)}</p>
    {view.employer.legalType === "research_institute" ? (
      <InstitutionTags locale={locale} institution={view.employer} />
    ) : (
      <InstitutionTags locale={locale} institution={view.employer} />
    )}
    {closed && <p class="notice">{t(locale, "jobs.closedNotice")}</p>}
    <section class="summary-grid">
      <div class="panel">
        <p class="muted">{t(locale, "jobs.phd")}</p>
        <p>{t(locale, phdKey)}</p>
      </div>
      <div class="panel">
        <p class="muted">{t(locale, "jobs.language")}</p>
        <p>{view.job.workingLanguages.join(", ")}</p>
      </div>
      <div class="panel">
        <p class="muted">{t(locale, "jobs.gross")}</p>
        <p>
          {view.job.paidStatus === "confirmed" && view.job.salary.amount == null
            ? t(locale, "jobs.salaryUnknown")
            : view.job.salary.amount != null
              ? `${view.job.salary.amount} ${view.job.salary.currency} / ${view.job.salary.cycle} (${view.job.salary.tax})`
              : t(locale, "status.unknown")}
        </p>
      </div>
      <div class="panel">
        <p class="muted">{t(locale, "application.currentRound")}</p>
        <p>{windowStatusLabel(view.summary.opportunityStatus, locale)}</p>
      </div>
    </section>
    <section class="panel">
      <h2>{t(locale, "application.timeline")}</h2>
      {view.windows.map((window) => (
        <article>
          <h3>{roundLabel(window, locale)} {window.roundLabelOriginal ? `· ${window.roundLabelOriginal}` : ""}</h3>
          <p>{windowRange(window, locale)}</p>
          {window.applicantScope && <p>{t(locale, "application.scope")}：{text(window.applicantScope, locale)}</p>}
        </article>
      ))}
    </section>
    <div class="actions">
      {!closed && applyUrl && (
        <a class="btn primary" href={applyUrl} rel="noopener noreferrer" target="_blank">
          {applyLabel} · {hostOf(applyUrl)}
        </a>
      )}
      <SaveButton client:load locale={locale} id={`job:${view.job.id}`} />
    </div>
    <p class="muted">{t(locale, "source.label")}: {view.job.sourceUrl}</p>
  </main>
</BaseLayout>
