---
import { withBase } from "../../../lib/base.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import InstitutionTags from "../../../components/InstitutionTags.astro";
import LiveWindows from "../../../components/LiveWindows.svelte";
import { findJob, isMasterEligible, jobOpportunityClosed, jobTrackOf, officialJobHref, safeHttpUrl } from "../../../lib/catalog";
import { dataClassKey, fieldSep, formatDate, formatSalary, jobSourceTitle, languageName, salaryTaxKey, text } from "../../../lib/format";
import { LOCALES, localeFromParam, t } from "../../../lib/i18n";
import { loadCatalog } from "../../../lib/loadCatalog";
import { loadSafetyOverlayFromDisk } from "../../../lib/loadSafetyOverlay";
import { applySafetyOverlay } from "../../../lib/safetyStatus";
import ExternalIcon from "../../../components/ExternalIcon.svelte";

export function getStaticPaths() {
  const catalog = loadCatalog();
  return LOCALES.flatMap((locale) => catalog.jobs.map((job) => ({ params: { locale, id: job.id } })));
}

const locale = localeFromParam(Astro.params.locale);
const overlay = loadSafetyOverlayFromDisk();
const catalog = applySafetyOverlay(loadCatalog(), overlay);
const view = findJob(catalog, Astro.params.id ?? "", new Date());
if (!view) throw new Error("Missing job");
const applyLabel = view.job.applicationMethod === "official_instructions" ? t(locale, "action.officialInstructions") : t(locale, "action.applyNow");
const sourceUrl = officialJobHref(view.job) || safeHttpUrl(view.job.sourceUrl);
const phdKey =
  view.job.doctoralEnrollment === "not_required"
    ? "jobs.phd.no"
    : view.job.doctoralEnrollment === "unspecified"
      ? "jobs.phd.unknown"
      : `jobs.phd.${view.job.doctoralEnrollment}`;
---
<BaseLayout locale={locale} title={text(view.job.title, locale)}>
  <main id="main" class="page detail-grid">
    <p><a href={withBase(`/${locale}/research-jobs`)}>{t(locale, "action.back")}</a></p>
    <p class="muted">{t(locale, dataClassKey(view.job.dataClass))} · {t(locale, `jobs.track.${jobTrackOf(view.job)}`)}</p>
    <h1>{text(view.job.title, locale)}</h1>
    {jobSourceTitle(view.job) !== text(view.job.title, locale) && (
      <p class="muted">{t(locale, "detail.originalTitle")}{fieldSep(locale)}{jobSourceTitle(view.job)}</p>
    )}
    <p>{text(view.employer.displayName, locale)}{view.job.city ? ` · ${text(view.job.city, locale)}` : ''}</p>
    <InstitutionTags locale={locale} institution={view.employer} />
    {jobOpportunityClosed(view.job) && <p class="notice">{t(locale, "jobs.closedNotice")}</p>}
    <section class="summary-grid">
      <div class="panel">
        <p class="muted">{t(locale, "jobs.phd")}</p>
        <p>{t(locale, phdKey)}</p>
      </div>
      <div class="panel">
        <p class="muted">{t(locale, "jobs.language")}</p>
        <p>{view.job.workingLanguages.map((code) => languageName(code, locale)).join(", ")}</p>
      </div>
      <div class="panel">
        <p class="muted">{t(locale, salaryTaxKey(view.job.salary.tax) === "salary.tax.gross" ? "jobs.gross" : "jobs.salary")} · {t(locale, salaryTaxKey(view.job.salary.tax))}</p>
        <p>
          {view.job.paidStatus === "confirmed" && view.job.salary.amount == null
            ? t(locale, "jobs.salaryUnknown")
            : view.job.salary.amount != null
              ? formatSalary(view.job.salary, locale)
              : t(locale, "status.unknown")}
        </p>
        {view.job.salary.basisFte != null && (
          <p>{t(locale, "jobs.fte")}{fieldSep(locale)}{view.job.salary.basisFte}</p>
        )}
        {view.job.employmentFte != null && (
          <p>{t(locale, "jobs.workloadFte")}{fieldSep(locale)}{view.job.employmentFte}</p>
        )}
        {view.job.employmentStartsAt && (
          <p>{t(locale, "jobs.employmentStart")}{fieldSep(locale)}{formatDate(view.job.employmentStartsAt, locale, "date")}</p>
        )}
      </div>
      <div class="panel">
        <p class="muted">{t(locale, "jobs.master")}</p>
        <p>{isMasterEligible(view.job) ? t(locale, "jobs.master") : t(locale, "jobs.notMaster")}</p>
        <p class="disclaimer">{t(locale, "jobs.masterMeansDegree")}</p>
      </div>
    </section>
    <section class="panel">
      <h2>{t(locale, "jobs.roleSummary")}</h2>
      <p>{view.job.roleSummary ? text(view.job.roleSummary, locale) : t(locale, "status.unknown")}</p>
      <h2>{t(locale, "jobs.qualificationEvidence")}</h2>
      <p>{view.job.qualificationEvidence ? text(view.job.qualificationEvidence, locale) : t(locale, "status.unknown")}</p>
      <h2>{t(locale, "jobs.applicationMaterials")}</h2>
      <p>{view.job.applicationMaterials ? text(view.job.applicationMaterials, locale) : t(locale, "status.unknown")}</p>
      {view.job.sourceLanguage && (
        <p class="muted">{t(locale, "jobs.sourceLanguage")}{fieldSep(locale)}{languageName(view.job.sourceLanguage, locale)}</p>
      )}
      {view.job.factsReviewedAt && (
        <p class="muted">{t(locale, "detail.factsReviewedAt")}{fieldSep(locale)}{view.job.factsReviewedAt.slice(0, 10)}</p>
      )}
    </section>
    <LiveWindows
      client:load
      locale={locale}
      windows={view.windows}
      wholeClosed={jobOpportunityClosed(view.job)}
      fallbackUrl={view.job.applicationUrl || view.job.sourceUrl}
      applyLabel={applyLabel}
      noticeIsNotApplication={view.job.applicationMethod === "official_instructions"}
      entityId={view.job.id}
      initialOverlay={overlay}
    >
    </LiveWindows>
    <p class="muted">
      {t(locale, "source.label")}{fieldSep(locale)}
      {sourceUrl ? (
        <a class="external" href={sourceUrl} rel="noopener noreferrer" target="_blank" data-official-detail>
          {sourceUrl}
          <ExternalIcon />
          <span class="visually-hidden">{t(locale, "action.external")}</span>
        </a>
      ) : (
        t(locale, "status.unknown")
      )}
    </p>
  </main>
</BaseLayout>
