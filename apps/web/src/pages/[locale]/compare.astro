---
import { LOCALES, localeFromParam, t } from "../../lib/i18n";
import { withBase } from "../../lib/base";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeFromParam(Astro.params.locale);
const target = withBase(`/${locale}/programmes`);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{t(locale, "brand.name")}</title>
  </head>
  <body>
    <p><a href={target}>{t(locale, "nav.programmes")}</a></p>
  </body>
</html>
