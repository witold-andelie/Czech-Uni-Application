---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CompareView from "../../components/CompareView.svelte";
import { LOCALES, localeFromParam, t } from "../../lib/i18n";
import { loadCatalog } from "../../lib/loadCatalog";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = localeFromParam(Astro.params.locale);
const catalog = loadCatalog();
---
<BaseLayout locale={locale} title={t(locale, "compare.title")}>
  <main id="main" class="page">
    <h1>{t(locale, "compare.title")}</h1>
    <CompareView client:load catalog={catalog} locale={locale} />
  </main>
</BaseLayout>
