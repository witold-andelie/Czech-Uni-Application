---
import { pathnameWithoutBase, withBase } from "../lib/base.ts";
import "../styles/global.css";
import { htmlLang, t, LOCALES } from "../lib/i18n";
import { NAV_ITEMS, navHref } from "../lib/nav";
import type { UiLocale } from "../lib/types";
import LocaleSwitcher from "../components/LocaleSwitcher.svelte";
import MobileNav from "../components/MobileNav.svelte";
import AuthorContact from "../components/AuthorContact.astro";
import favicon from "../assets/favicon.svg?url";

interface Props {
  locale: UiLocale;
  title: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const path = pathnameWithoutBase(Astro.url.pathname);
const search = Astro.url.search;
const indexable = LOCALES.some((item) => path.startsWith(`/${item}/`)) && !path.split("/").includes("404");
const absolute = (pathname: string) => new URL(withBase(pathname), Astro.site!).href;
const canonical = absolute(path);
const alternate = (item: string) => absolute(["", item, ...path.split("/").slice(2)].join("/"));
const brand = t(locale, "brand.name");
const documentTitle = title === brand ? brand : `${title} · ${brand}`;
const structuredData = JSON.stringify({
        "@context": "https://schema.org", "@type": "WebPage",
        url: canonical, name: documentTitle, inLanguage: htmlLang(locale),
        description: description ?? t(locale, "meta.description"),
        isPartOf: { "@type": "WebSite", name: brand, url: absolute("/") },
      }).replace(/</g, "\\u003c");
const nav = NAV_ITEMS.map((item) => ({
  href: navHref(locale, item.path),
  key: item.key,
  match: item.match,
}));
---
<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t(locale, "meta.description")} />
    <title>{documentTitle}</title>
    {indexable ? <>
      <link rel="canonical" href={canonical} />
      {LOCALES.map((item) => <link rel="alternate" hreflang={htmlLang(item)} href={alternate(item)} />)}
      <link rel="alternate" hreflang="x-default" href={alternate("zh-CN")} />
      <meta property="og:type" content="website" />
      <meta property="og:url" content={canonical} />
      <meta property="og:title" content={documentTitle} />
      <meta property="og:description" content={description ?? t(locale, "meta.description")} />
      <script is:inline type="application/ld+json" set:html={structuredData}></script>
    </> : <meta name="robots" content="noindex, follow" />}
    <script is:inline>
      (function () {
        try {
          var teaching = new URLSearchParams(location.search).get("teachingLanguage");
          if (teaching === "en" || teaching === "cs" || teaching === "all") {
            document.documentElement.setAttribute("data-teaching", teaching);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, "skip.nav")}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={withBase(`/${locale}/`)}>{t(locale, "brand.name")}</a>
        <nav class="nav-main nav-desktop" aria-label={t(locale, "nav.main")}>
          {nav.map((item) => (
            <a href={item.href} aria-current={path.includes(item.match) ? "page" : undefined}>
              {t(locale, item.key)}
            </a>
          ))}
        </nav>
        <div class="header-tools tools-desktop">
          <LocaleSwitcher client:load locale={locale} pathname={path} search={search} />
        </div>
        <MobileNav client:load locale={locale} pathname={path} search={search} />
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <p>{t(locale, "recognition.disclaimer")}</p>
        <p>{t(locale, "footer.disclaimer")}</p>
      </div>
    </footer>
    <AuthorContact locale={locale} />
  </body>
</html>
