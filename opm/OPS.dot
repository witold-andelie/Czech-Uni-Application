digraph OPS {
// Explicit OPM-to-DOT mapping; see README.md. Layout is not execution order.
  graph [rankdir="LR", compound="true", bgcolor="#FFFFFF", pad="0.3", nodesep="0.38", ranksep="0.65", splines="spline", fontname="Microsoft YaHei", fontsize="18", labelloc="t", label="OPS  目录维护的支撑环境\nISO 19450:2024 · OPM semantic mapping / DOT"];
  node [fontname="Microsoft YaHei", fontsize="11", margin="0.14,0.10", penwidth="1.3"];
  edge [fontname="Segoe UI", fontsize="9", arrowsize="0.7", penwidth="1.1"];
  subgraph cluster_jobs {
    graph [label="科研岗位记录\nResearch Job Record", color="#64748B", style="solid", fontsize="12", opm_kind="object", opm_id="jobs"];
    jobs [label="", shape="point", width="0.01", style="invis", opm_kind="object", opm_anchor="true"];
    eligiblejob [label="硕士可申请且确认带薪\nmaster eligible and paid", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="jobs"];
    otherjob [label="其他资格或证据不足\nother or unresolved", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="jobs"];
    uncheckedjob [label="资格未核验\nunchecked", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="jobs"];
  }
  subgraph cluster_refreshlease {
    graph [label="刷新任务租约\nRefresh Lease", color="#64748B", style="solid", fontsize="12", opm_kind="object", opm_id="refreshlease"];
    leaseavailable [label="可获取\navailable", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="refreshlease"];
    leaseexpired [label="已过期\nexpired", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="refreshlease"];
    leaseheld [label="持有中\nheld", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="refreshlease"];
  }
  subgraph cluster_schedulequeue {
    graph [label="持久调度队列\nPersistent Schedule Queue", color="#64748B", style="solid", fontsize="12", opm_kind="object", opm_id="schedulequeue"];
    schedulequeue [label="", shape="point", width="0.01", style="invis", opm_kind="object", opm_anchor="true"];
    schedfailed [label="失败待重试\nfailed", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="schedulequeue"];
    schedidle [label="空闲\nidle", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="schedulequeue"];
    schedpending [label="已排队\nscheduled", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="schedulequeue"];
    schedrunning [label="运行中\nrunning", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="schedulequeue"];
  }
  subgraph cluster_sourceattempt {
    graph [label="逐来源刷新尝试\nSource Refresh Attempt", color="#64748B", style="solid", fontsize="12", opm_kind="object", opm_id="sourceattempt"];
    attemptfailed [label="抓取或解析失败\nfailed", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="sourceattempt"];
    attemptpending [label="已尝试\nattempted", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="sourceattempt"];
    attemptsucceeded [label="抓取与解析成功\nsucceeded", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="sourceattempt"];
  }
  subgraph cluster_vacancycandidate {
    graph [label="动态发现岗位候选\nDynamic Vacancy Candidate", color="#64748B", style="solid", fontsize="12", opm_kind="object", opm_id="vacancycandidate"];
    vacancydiscovered [label="已发现\ndiscovered", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="vacancycandidate"];
    vacancyexcluded [label="不再符合研究或技术岗位范围\noutside supported catalogue scope", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="vacancycandidate"];
    vacancyquarantined [label="法定雇主未明待核验\nquarantined", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="vacancycandidate"];
    vacancyready [label="正文已定界且雇主可归属\nscoped and attributable", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="vacancycandidate"];
    vacancyunavailable [label="完整目录中已消失\nunavailable", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="vacancycandidate"];
  }
  catalog [label="已发布目录\nPublished Catalogue", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  ciworkflow [label="固定依赖的持续集成工作流\nPinned CI Workflow", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  clock [label="每五天调度（120 小时）\nFive Day Schedule", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  coveragecalculate [label="计算来源覆盖与缺口\nSource Coverage Calculating", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  coveragereport [label="绑定固定分母的覆盖报告\nDenominator Bound Coverage Report", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  czuczechprogrammeavailability [label="刷新 CZU 捷克入口项目目录\nCZU Czech Portal Programme Refreshing", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  czuczechprogrammeclock [label="CZU 捷克入口项目 2 小时刷新周期\nTwo Hour CZU Czech Portal Programme Refresh", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  czuczechprogrammedirectory [label="CZU 捷克入口项目候选目录\nCZU Czech Portal Programme Candidate Directory", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  czudoctoralprogrammeavailability [label="刷新 CZU 博士学院证据\nCZU Doctoral Faculty Evidence Refreshing", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  czudoctoralprogrammeclock [label="CZU 博士学院来源 2 小时刷新周期\nTwo Hour CZU Doctoral Faculty Refresh", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  czudoctoralprogrammedirectory [label="CZU 博士项目候选目录\nCZU Doctoral Candidate Directory", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  czuprogrammeavailability [label="刷新 CZU 项目目录与窗口\nCZU Programme Window Refreshing", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  czuprogrammeclock [label="CZU 项目窗口 2 小时刷新周期\nTwo Hour CZU Programme Window Refresh", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  czuprogrammedirectory [label="CZU 英语项目候选目录\nCZU English Programme Candidate Directory", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  dailyclock [label="岗位 1 小时状态复核周期\nOne Hour Job Status Check", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  discoveryclock [label="岗位目录 4 小时发现周期\nFour Hour Job Discovery", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  editor [label="内容审核者\nContent Reviewer", shape="box", style="dashed,filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object", penwidth="2.6"];
  jobinspection [label="岗位开放状态核查\nJob Status Inspection", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  jobrecheck [label="复核岗位开放状态\nJob Status Rechecking", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  leaseacquire [label="原子获取刷新租约\nRefresh Lease Acquiring", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  leaseexpire [label="标记租约到期\nRefresh Lease Expiring", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  leasereclaim [label="回收过期租约\nExpired Lease Reclaiming", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  leaserelease [label="按拥有者释放租约\nRefresh Lease Releasing", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  maintain [label="维护可信目录\nCatalogue Maintaining", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  osmutex [label="操作系统文件互斥锁\nOperating System File Mutex", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  platform [label="捷克留学与科研平台\nCzech Opportunity Platform", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  programmeavailability [label="刷新项目目录与可用信号\nProgramme Availability Refreshing", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  programmeclock [label="项目可用性 2 小时刷新周期\nTwo Hour Programme Availability Refresh", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  programmedirectory [label="DZS 项目候选目录\nDZS Programme Candidate Directory", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  quality [label="数据与翻译发布规则\nContent Rules", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  registry [label="捷克官方高校来源名录\nOfficial Institution Source Registry", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  run [label="采集批次与覆盖报告\nCrawl Run", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  runfail [label="记录来源失败\nSource Failure Recording", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  runnercheckpoint [label="采集运行检查点\nPersisted Runner Checkpoint", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  runretry [label="按退避时间重排来源\nSource Retry Scheduling", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  runstart [label="启动逐来源尝试\nSource Attempt Starting", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  runsucceed [label="记录来源成功\nSource Success Recording", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  schedule [label="派发全覆盖采集\nCoverage Refresh Scheduling", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  slalog [label="来源 SLA 违约记录\nSLA Breach Log", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  slamonitor [label="监测来源 SLA\nSource SLA Monitoring", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  source [label="官方来源\nOfficial Source", shape="box", style="dashed,filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  vacancydiscover [label="按注册来源发现岗位\nRegistered Vacancy Discovering", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  editor -> maintain [arrowhead="dot", color="#1F2937", label="agent", opm_relation="agent"];
  platform -> maintain [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  source -> maintain [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  quality -> maintain [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  maintain -> catalog [dir="both", arrowhead="normal", arrowtail="normal", color="#174DA6", label="effect", opm_relation="effect"];
  clock -> schedule [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  registry -> schedule [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  schedidle -> schedule [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  schedule -> schedpending [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  schedule -> run [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  osmutex -> leaseacquire [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  leaseavailable -> leaseacquire [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  leaseacquire -> leaseheld [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  clock -> leaseexpire [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  leaseheld -> leaseexpire [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  leaseexpire -> leaseexpired [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  osmutex -> leasereclaim [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  clock -> leasereclaim [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  leaseexpired -> leasereclaim [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  leasereclaim -> leaseheld [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  osmutex -> leaserelease [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  leaseheld -> leaserelease [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  leaserelease -> leaseavailable [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  schedpending -> runstart [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  runstart -> schedrunning [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  leaseheld -> runstart [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  source -> runstart [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  runstart -> attemptpending [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  schedrunning -> runsucceed [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  attemptpending -> runsucceed [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  runsucceed -> schedidle [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  runsucceed -> attemptsucceeded [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  schedrunning -> runfail [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  attemptpending -> runfail [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  runfail -> schedfailed [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  runfail -> attemptfailed [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  schedfailed -> runretry [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  attemptfailed -> runretry [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  clock -> runretry [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  runretry -> schedpending [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  runretry -> attemptpending [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  schedulequeue -> slamonitor [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument", ltail="cluster_schedulequeue"];
  clock -> slamonitor [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  slamonitor -> slalog [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  dailyclock -> jobrecheck [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  registry -> jobrecheck [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  osmutex -> jobrecheck [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  jobrecheck -> jobinspection [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  jobrecheck -> jobs [dir="both", arrowhead="normal", arrowtail="normal", color="#174DA6", label="effect", opm_relation="effect", lhead="cluster_jobs"];
  discoveryclock -> vacancydiscover [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  registry -> vacancydiscover [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  osmutex -> vacancydiscover [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  vacancydiscover -> vacancydiscovered [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  programmeclock -> programmeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  source -> programmeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  registry -> programmeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  osmutex -> programmeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  programmeavailability -> programmedirectory [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  czuprogrammeclock -> czuprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  source -> czuprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  registry -> czuprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  osmutex -> czuprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  czuprogrammeavailability -> czuprogrammedirectory [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  czuczechprogrammeclock -> czuczechprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  source -> czuczechprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  registry -> czuczechprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  osmutex -> czuczechprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  czuczechprogrammeavailability -> czuczechprogrammedirectory [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  czudoctoralprogrammeclock -> czudoctoralprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  source -> czudoctoralprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  registry -> czudoctoralprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  osmutex -> czudoctoralprogrammeavailability [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  czudoctoralprogrammeavailability -> czudoctoralprogrammedirectory [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  registry -> coveragecalculate [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  programmedirectory -> coveragecalculate [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  czuprogrammedirectory -> coveragecalculate [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  czuczechprogrammedirectory -> coveragecalculate [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  czudoctoralprogrammedirectory -> coveragecalculate [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  jobs -> coveragecalculate [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument", ltail="cluster_jobs"];
  catalog -> coveragecalculate [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  coveragecalculate -> coveragereport [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  run -> maintain [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  ciworkflow -> schedule [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  schedule -> runnercheckpoint [dir="both", arrowhead="normal", arrowtail="normal", color="#174DA6", label="effect", opm_relation="effect"];
  runnercheckpoint -> schedule [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
}
