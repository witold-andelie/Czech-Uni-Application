digraph SD5 {
// Explicit OPM-to-DOT mapping; see README.md. Layout is not execution order.
  graph [rankdir="LR", compound="true", bgcolor="#FFFFFF", pad="0.3", nodesep="0.38", ranksep="0.65", splines="spline", fontname="Microsoft YaHei", fontsize="18", labelloc="t", label="SD5  硕士可申请的带薪科研资格\nISO 19450:2024 · OPM semantic mapping / DOT"];
  node [fontname="Microsoft YaHei", fontsize="11", margin="0.14,0.10", penwidth="1.3"];
  edge [fontname="Segoe UI", fontsize="9", arrowsize="0.7", penwidth="1.1"];
  subgraph cluster_jobs {
    graph [label="科研岗位记录\nResearch Job Record", color="#64748B", style="solid", fontsize="12", opm_kind="object", opm_id="jobs"];
    jobs [label="", shape="point", width="0.01", style="invis", opm_kind="object", opm_anchor="true"];
    eligiblejob [label="硕士可申请且确认带薪\nmaster eligible and paid", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="jobs"];
    otherjob [label="其他资格或证据不足\nother or unresolved", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="jobs"];
    uncheckedjob [label="资格未核验\nunchecked", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="jobs"];
  }
  subgraph cluster_worklang {
    graph [label="工作语言\nWorking Languages", color="#64748B", style="solid", fontsize="12", opm_kind="object", opm_id="worklang"];
    worklang [label="", shape="point", width="0.01", style="invis", opm_kind="object", opm_anchor="true"];
    worklangspecified [label="公告已说明\nspecified by the vacancy", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="worklang"];
    worklangund [label="公告未说明（BCP 47 und）\nnot specified (BCP 47 und)", shape="box", style="rounded,filled", fillcolor="#FFF7E6", color="#B7791F", opm_kind="state", opm_owner="worklang"];
  }
  application [label="官方申请目标\nOfficial Application Target", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  catalog [label="已发布目录\nPublished Catalogue", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  degree [label="学位要求\nDegree Requirement", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  editor [label="内容审核者\nContent Reviewer", shape="box", style="dashed,filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object", penwidth="2.6"];
  evidence [label="来源证据\nSource Evidence", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  jobcriteria [label="工作语言与博士注册偏好\nJob Criteria", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  jobfilter [label="按工作语言与博士要求筛选\nResearch Job Filtering", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  jobother [label="记录其他资格或未知\nOther Eligibility Recording", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  jobresults [label="带薪科研检索结果\nResearch Job Results", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  jobverify [label="核验硕士资格与带薪证据\nMaster Eligibility Verifying", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  navigate [label="直达官方申请页\nApplication Opening", shape="ellipse", style="filled", fillcolor="#EFF6FF", color="#174DA6", opm_kind="process"];
  navigation [label="官方申请页导航\nExternal Navigation", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  pay [label="报酬、薪资基准与实际工时\nCompensation and Workload Terms", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  phd [label="博士注册要求\nDoctoral Enrollment Requirement", shape="box", style="filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object"];
  user [label="申请者\nApplicant", shape="box", style="dashed,filled", fillcolor="#F8FAFC", color="#64748B", opm_kind="object", penwidth="2.6"];
  jobs -> degree [dir="none", color="#64748B", style="dashed", label="exhibition", opm_relation="exhibition", ltail="cluster_jobs"];
  jobs -> phd [dir="none", color="#64748B", style="dashed", label="exhibition", opm_relation="exhibition", ltail="cluster_jobs"];
  jobs -> pay [dir="none", color="#64748B", style="dashed", label="exhibition", opm_relation="exhibition", ltail="cluster_jobs"];
  jobs -> worklang [dir="none", color="#64748B", style="dashed", label="exhibition", opm_relation="exhibition", ltail="cluster_jobs", lhead="cluster_worklang"];
  uncheckedjob -> jobverify [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  jobverify -> eligiblejob [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  evidence -> jobverify [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  editor -> jobverify [arrowhead="dot", color="#1F2937", label="agent", opm_relation="agent"];
  uncheckedjob -> jobother [arrowhead="normal", color="#B45309", label="input", opm_relation="input"];
  jobother -> otherjob [arrowhead="normal", color="#166534", label="output", opm_relation="output"];
  evidence -> jobother [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  editor -> jobother [arrowhead="dot", color="#1F2937", label="agent", opm_relation="agent"];
  eligiblejob -> jobfilter [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  jobcriteria -> jobfilter [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  catalog -> jobfilter [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  jobfilter -> jobresults [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
  user -> navigate [arrowhead="dot", color="#1F2937", label="agent", opm_relation="agent"];
  jobresults -> navigate [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  application -> navigate [arrowhead="odot", color="#64748B", label="instrument", opm_relation="instrument"];
  navigate -> navigation [arrowhead="normal", color="#166534", label="result", opm_relation="result"];
